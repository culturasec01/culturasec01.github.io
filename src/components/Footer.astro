---
import { SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer style="background-color: #21222c; border-top: 1px solid #44475a; margin-top: 4rem; padding: 3rem 2rem;">
	<div style="max-width: 1000px; margin: 0 auto; text-align: center;">
		<p style="color: #f8f8f2; font-size: 1rem; margin-bottom: 0.5rem;">
			&copy; {today.getFullYear()} {SITE_AUTHOR}. Todos os direitos reservados.
		</p>
		<p style="color: #8be9fd; font-size: 0.95rem;">
			Feito com <a href="https://astro.build" style="color: #8be9fd; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#50fa7b'" onmouseout="this.style.color='#8be9fd'">Astro</a> e hospedado em <a href="https://pages.cloudflare.com" style="color: #8be9fd; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#50fa7b'" onmouseout="this.style.color='#8be9fd'">Cloudflare Pages</a>
		</p>
	</div>
</footer>

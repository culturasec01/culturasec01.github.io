---
import { SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 mt-16">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
		<p class="text-gray-600 dark:text-gray-400">
			&copy; {today.getFullYear()} {SITE_AUTHOR}. Todos os direitos reservados.
		</p>
		<p class="text-gray-500 dark:text-gray-500 text-sm mt-2">
			Feito com <a href="https://astro.build" class="hover:text-blue-600 dark:hover:text-blue-400">Astro</a> e hospedado em <a href="https://pages.cloudflare.com" class="hover:text-blue-600 dark:hover:text-blue-400">Cloudflare Pages</a>
		</p>
	</div>
</footer>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			.prose {
				color: #f8f8f2;
			}
			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				color: #f8f8f2;
				font-weight: 700;
				margin-bottom: 1rem;
				margin-top: 1.5rem;
			}
			.prose h1 {
				font-size: 2rem;
			}
			.prose h2 {
				font-size: 1.75rem;
				border-bottom: 2px solid #44475a;
				padding-bottom: 0.5rem;
			}
			.prose h3 {
				font-size: 1.5rem;
			}
			.prose p {
				margin-bottom: 1rem;
				line-height: 1.7;
				color: #f8f8f2;
			}
			.prose strong {
				font-weight: 700;
				color: #f8f8f2;
			}
			.prose em {
				font-style: italic;
			}
			.prose ul, .prose ol {
				margin-bottom: 1rem;
				margin-left: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
				color: #f8f8f2;
			}
			.prose code {
				background-color: #44475a;
				color: #ff79c6;
				padding: 0.25rem 0.5rem;
				border-radius: 0.25rem;
				font-family: monospace;
				font-size: 0.9em;
			}
			.prose pre {
				background-color: #21222c;
				color: #f8f8f2;
				padding: 1rem;
				border-radius: 0.5rem;
				overflow-x: auto;
				margin-bottom: 1rem;
				border: 1px solid #44475a;
			}
			.prose pre code {
				background-color: transparent;
				color: #f8f8f2;
				padding: 0;
				border-radius: 0;
			}
			.prose a {
				color: #8be9fd;
				text-decoration: underline;
			}
			.prose a:hover {
				color: #50fa7b;
			}
			.prose blockquote {
				border-left: 4px solid #8be9fd;
				padding-left: 1rem;
				color: #6272a4;
				font-style: italic;
				margin: 1rem 0;
			}
			.prose img {
				border-radius: 0.5rem;
				max-width: 100%;
				height: auto;
			}
			.prose table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 1rem;
			}
			.prose th, .prose td {
				border: 1px solid #44475a;
				padding: 0.75rem;
				text-align: left;
				color: #f8f8f2;
			}
			.prose th {
				background-color: #44475a;
				font-weight: 700;
			}
		</style>
	</head>

	<body style="background-color: #282a36; color: #f8f8f2;">
		<Header />
		<main style="max-width: 800px; margin: 0 auto; padding: 3rem 2rem;">
			<article>
				<div style="margin-bottom: 2rem;">
					<a href="/blog" style="color: #8be9fd; text-decoration: none; display: inline-block;">
						← Voltar para Artigos
					</a>
				</div>

				{heroImage && (
					<div style="margin-bottom: 2rem;">
						<Image width={800} height={400} src={heroImage} alt="" style="border-radius: 0.5rem; max-width: 100%; height: auto;" />
					</div>
				)}

				<header style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #44475a;">
					<h1 style="font-family: Georgia, serif; font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: #f8f8f2;">
						{title}
					</h1>
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
						<div>
							<time style="color: #6272a4;">
								<FormattedDate date={pubDate} />
							</time>
							{
								updatedDate && (
									<div style="font-size: 0.875rem; color: #6272a4; font-style: italic;">
										Atualizado em <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{tags && tags.length > 0 && (
							<div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
								{tags.map((tag) => (
									<a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} style="display: inline-block; background-color: rgba(139, 233, 253, 0.1); color: #8be9fd; font-size: 0.875rem; padding: 0.5rem 0.75rem; border-radius: 9999px; border: 1px solid rgba(139, 233, 253, 0.3); text-decoration: none; transition: all 0.2s;">
										{tag}
									</a>
								))}
							</div>
						)}
					</div>
				</header>

				<div class="prose" style="margin-bottom: 3rem;">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

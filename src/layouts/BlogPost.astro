---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			.prose {
				color: #f8f8f2 !important;
			}
			.prose * {
				color: #f8f8f2 !important;
			}
			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				color: #f8f8f2 !important;
				font-weight: 700;
				margin-bottom: 1rem;
				margin-top: 1.5rem;
			}
			.prose h1 {
				font-size: 2rem;
			}
			.prose h2 {
				font-size: 1.75rem;
				border-bottom: 2px solid #44475a;
				padding-bottom: 0.5rem;
			}
			.prose h3 {
				font-size: 1.5rem;
			}
			.prose p {
				margin-bottom: 1rem;
				line-height: 1.7;
				color: #f8f8f2;
			}
			.prose strong {
				font-weight: 700;
				color: #f8f8f2;
			}
			.prose em {
				font-style: italic;
			}
			.prose ul, .prose ol {
				margin-bottom: 1rem;
				margin-left: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
				color: #f8f8f2;
			}
			.prose code {
				background-color: #44475a;
				color: #ff79c6;
				padding: 0.25rem 0.5rem;
				border-radius: 0.25rem;
				font-family: monospace;
				font-size: 0.9em;
			}
			.prose pre {
				background-color: #21222c;
				color: #f8f8f2;
				padding: 0;
				border-radius: 0.5rem;
				overflow-x: auto;
				margin-bottom: 1rem;
				border: 1px solid #44475a;
				position: relative;
			}

			.prose pre[data-language]::before {
				content: attr(data-language);
				position: absolute;
				top: 0;
				right: 0;
				background-color: #44475a;
				color: #8be9fd;
				padding: 0.25rem 0.75rem;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				border-radius: 0 0.5rem 0 0;
				border-left: 1px solid #44475a;
				border-bottom: 1px solid #44475a;
			}

			.prose pre code {
				background-color: transparent !important;
				padding: 1rem;
				border-radius: 0;
				display: block;
				font-size: 0.95em;
				line-height: 1.6;
			}

			.prose pre code span {
				color: inherit !important;
			}
			.prose a {
				color: #8be9fd;
				text-decoration: underline;
			}
			.prose a:hover {
				color: #50fa7b;
			}
			.prose blockquote {
				border-left: 4px solid #8be9fd;
				padding-left: 1rem;
				color: #6272a4;
				font-style: italic;
				margin: 1rem 0;
			}
			.prose img {
				border-radius: 0.5rem;
				max-width: 100%;
				height: auto;
			}
			.prose table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 1rem;
			}
			.prose th, .prose td {
				border: 1px solid #44475a;
				padding: 0.75rem;
				text-align: left;
				color: #f8f8f2;
			}
			.prose th {
				background-color: #44475a;
				font-weight: 700;
			}
		</style>
	</head>

	<body style="background-color: #282a36; color: #f8f8f2;">
		<main style="max-width: 800px; margin: 0 auto; padding: 3rem 2rem;">
			<article>
				<div style="margin-bottom: 2rem;">
					<a href="/blog" style="color: #8be9fd; text-decoration: none; display: inline-block;">
						← Voltar para Artigos
					</a>
				</div>

				{heroImage && (
					<div style="margin-bottom: 2rem;">
						<Image width={800} height={400} src={heroImage} alt="" style="border-radius: 0.5rem; max-width: 100%; height: auto;" />
					</div>
				)}

				<header style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #44475a;">
					<h1 style="font-family: Georgia, serif; font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: #f8f8f2;">
						{title}
					</h1>
					<time style="color: #6272a4;">
						<FormattedDate date={pubDate} />
					</time>
					{
						updatedDate && (
							<div style="font-size: 0.875rem; color: #6272a4; font-style: italic; margin-top: 0.5rem;">
								Atualizado em <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</header>

				<div class="prose" style="margin-bottom: 3rem;">
					<slot />
				</div>
			</article>
		</main>
	</body>
</html>

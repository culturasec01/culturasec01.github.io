---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-gradient {
				background: linear-gradient(135deg, #8be9fd 0%, #50fa7b 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.card-gradient {
				background: linear-gradient(135deg, rgba(139, 233, 253, 0.05) 0%, rgba(80, 250, 123, 0.05) 100%);
			}

			.card-hover {
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.card-hover:hover {
				transform: translateY(-8px);
				box-shadow: 0 20px 50px rgba(139, 233, 253, 0.1);
				border-color: #8be9fd;
			}
		</style>
	</head>
	<body style="background-color: #282a36; color: #f8f8f2;">
		<Header />
		<main style="max-width: 1200px; margin: 0 auto; padding: 3rem 1.5rem;">
			<!-- Hero Section -->
			<section style="margin-bottom: 5rem; text-align: center;">
				<h1 class="hero-gradient" style="font-size: 3.5rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -0.02em;">
					{SITE_TITLE}
				</h1>
				<p style="font-size: 1.25rem; color: #b0b0b0; margin-bottom: 2rem; line-height: 1.6;">
					{SITE_DESCRIPTION}
				</p>
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="/blog" style="display: inline-block; background: linear-gradient(135deg, #8be9fd, #50fa7b); color: #282a36; font-weight: 700; padding: 0.875rem 2rem; border-radius: 0.5rem; text-decoration: none; transition: all 0.3s; box-shadow: 0 10px 25px rgba(139, 233, 253, 0.2);">
						Ver Todos os Artigos
					</a>
					<a href="/tags" style="display: inline-block; background: rgba(139, 233, 253, 0.1); color: #8be9fd; font-weight: 700; padding: 0.875rem 2rem; border-radius: 0.5rem; text-decoration: none; border: 2px solid #8be9fd; transition: all 0.3s;">
						Explorar Tags
					</a>
				</div>
			</section>

			<!-- Featured Articles Section -->
			<section>
				<div style="margin-bottom: 3rem;">
					<h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: #f8f8f2;">
						Artigos Recentes
					</h2>
					<div style="width: 60px; height: 4px; background: linear-gradient(90deg, #8be9fd, #50fa7b); border-radius: 2px;"></div>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem;">
					{posts.map((post) => (
						<article class="card-hover card-gradient" style="background-color: #21222c; border: 1px solid #44475a; border-radius: 0.75rem; padding: 1.5rem; cursor: pointer;">
							<a href={`/blog/${post.id}/`} style="text-decoration: none; color: inherit; display: block;">
								<!-- Article Header -->
								<div style="margin-bottom: 1rem;">
									<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
										<span style="font-size: 0.875rem; color: #8be9fd; font-weight: 600;">
											{post.data.tags?.[0] || 'ARTIGO'}
										</span>
										<span style="width: 4px; height: 4px; background: #50fa7b; border-radius: 50%;"></span>
										<time style="font-size: 0.875rem; color: #6272a4;">
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
									<h3 style="font-size: 1.5rem; font-weight: 700; color: #f8f8f2; margin: 0; line-height: 1.3;">
										{post.data.title}
									</h3>
								</div>

								<!-- Description -->
								<p style="color: #b0b0b0; margin-bottom: 1.5rem; line-height: 1.6; font-size: 0.95rem;">
									{post.data.description}
								</p>

								<!-- Tags -->
								{post.data.tags && post.data.tags.length > 0 && (
									<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; padding-top: 1rem; border-top: 1px solid #44475a;">
										{post.data.tags.slice(0, 3).map((tag) => (
											<span style="background: rgba(139, 233, 253, 0.1); color: #8be9fd; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 9999px; border: 1px solid rgba(139, 233, 253, 0.3);">
												{tag}
											</span>
										))}
									</div>
								)}
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

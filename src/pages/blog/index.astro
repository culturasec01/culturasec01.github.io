---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Artigos - ${SITE_TITLE}`} description="Todos os artigos técnicos" />
	</head>
	<body class="bg-white dark:bg-gray-950">
		<Header />
		<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">
				Artigos
			</h1>
			<p class="text-lg text-gray-600 dark:text-gray-400 mb-12">
				Explore {posts.length} artigos sobre segurança, desenvolvimento e engenharia reversa.
			</p>

			{posts.length > 0 ? (
				<div class="space-y-6">
					{posts.map((post) => (
						<article class="group border border-gray-200 dark:border-gray-800 rounded-lg p-6 hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-600 transition">
							<a href={`/blog/${post.id}/`} class="block">
								<h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
									{post.data.title}
								</h2>
								<p class="text-gray-600 dark:text-gray-400 mb-4">
									{post.data.description}
								</p>
								<div class="flex items-center justify-between flex-wrap gap-2">
									<time class="text-sm text-gray-500 dark:text-gray-500">
										<FormattedDate date={post.data.pubDate} />
									</time>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="flex gap-2 flex-wrap">
											{post.data.tags.slice(0, 3).map((tag) => (
												<a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="inline-block bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs px-2 py-1 rounded hover:bg-blue-200 dark:hover:bg-blue-800 transition">
													{tag}
												</a>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
			) : (
				<div class="text-center py-12">
					<p class="text-gray-600 dark:text-gray-400 text-lg">
						Nenhum artigo publicado ainda.
					</p>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>

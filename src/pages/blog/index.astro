---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsPerPage = 9;
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const posts = allPosts.slice(startIndex, startIndex + postsPerPage);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Artigos - ${SITE_TITLE}`} description="Todos os artigos técnicos" />
		<style>
			body {
				background-color: #282a36;
				color: #f8f8f2;
			}

			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 3rem 2rem;
			}

			h1 {
				font-family: 'Georgia', 'Times New Roman', serif;
				font-size: 2.5rem;
				font-weight: 700;
				margin-bottom: 3rem;
				color: #f8f8f2;
			}

			.articles-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 2rem;
			}

			.article-card {
				background-color: #21222c;
				border: 1px solid #44475a;
				border-radius: 0.5rem;
				overflow: hidden;
				transition: all 0.3s ease;
				cursor: pointer;
			}

			.article-card:hover {
				border-color: #8be9fd;
				transform: translateY(-4px);
				box-shadow: 0 10px 20px rgba(139, 233, 253, 0.1);
			}

			.article-card a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
				display: flex;
				flex-direction: column;
			}

			.article-image {
				width: 100%;
				height: 180px;
				object-fit: cover;
				background-color: #44475a;
			}

			.article-content {
				padding: 1.5rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.article-title {
				font-family: 'Georgia', 'Times New Roman', serif;
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.4;
				color: #f8f8f2;
				transition: color 0.2s ease;
			}

			.article-card:hover .article-title {
				color: #8be9fd;
			}

			.no-articles {
				text-align: center;
				padding: 3rem;
				color: #6272a4;
			}

			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1rem;
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid #44475a;
			}

			.pagination a, .pagination span {
				padding: 0.75rem 1rem;
				border-radius: 0.25rem;
				transition: all 0.2s;
				cursor: pointer;
			}

			.pagination a {
				background-color: #44475a;
				color: #f8f8f2;
				text-decoration: none;
				border: 1px solid #44475a;
			}

			.pagination a:hover {
				background-color: #8be9fd;
				color: #282a36;
				border-color: #8be9fd;
			}

			.pagination .active {
				background-color: #8be9fd;
				color: #282a36;
				border: 1px solid #8be9fd;
				font-weight: 600;
			}

			.pagination .disabled {
				background-color: #21222c;
				color: #6272a4;
				border: 1px solid #44475a;
				cursor: not-allowed;
				opacity: 0.5;
			}

			@media (max-width: 640px) {
				main {
					padding: 1.5rem 1rem;
				}

				h1 {
					font-size: 1.75rem;
					margin-bottom: 2rem;
				}

				.articles-grid {
					grid-template-columns: 1fr;
				}

				.pagination {
					flex-wrap: wrap;
					gap: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Artigos</h1>

			{posts.length > 0 ? (
				<>
					<div class="articles-grid">
						{posts.map((post) => (
							<article class="article-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image
											src={post.data.heroImage}
											alt={post.data.title}
											width={280}
											height={180}
											class="article-image"
										/>
									)}
									<div class="article-content">
										<h2 class="article-title">{post.data.title}</h2>
									</div>
								</a>
							</article>
						))}
					</div>

					{totalPages > 1 && (
						<div class="pagination">
							{currentPage > 1 && (
								<a href={`/blog?page=${currentPage - 1}`}>← Anterior</a>
							)}

							{Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
								page === currentPage ? (
									<span class="active">{page}</span>
								) : (
									<a href={`/blog?page=${page}`}>{page}</a>
								)
							))}

							{currentPage < totalPages && (
								<a href={`/blog?page=${currentPage + 1}`}>Próxima →</a>
							)}
						</div>
					)}
				</>
			) : (
				<div class="no-articles">
					<p>Nenhum artigo publicado ainda.</p>
				</div>
			)}
		</main>
	</body>
</html>
